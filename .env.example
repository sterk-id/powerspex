# Explicit local development/test database mode. Never use SQLite in production.
PAYLOAD_DATABASE=sqlite

# Optional locally when PAYLOAD_DATABASE=sqlite. Required in production.
# Example: postgresql://postgres:postgres@127.0.0.1:5432/powerspex
DATABASE_URI=

# Required in production. Generate a unique value of at least 32 characters.
# Local development can use this non-sensitive placeholder in .env.local.
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Public canonical origin, without a trailing slash. Required in production.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
